# Docker 支持补丁 —— 基于从机内 4.19.157 内核里提取的真实 .config
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_CGROUP_DEVICE=y

# IPC_NS 依赖 (SYSVIPC || POSIX_MQUEUE)，本树两个都是关的，所以要先开一个
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# Android 的 paranoid network 会按 gid 拦 socket，容器里网络直接不通
# CONFIG_ANDROID_PARANOID_NETWORK is not set
