# Docker 支持补丁 —— 基于从机内 4.19.157 内核里提取的真实 .config
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_CGROUP_DEVICE=y

# IPC_NS 依赖 (SYSVIPC || POSIX_MQUEUE)，本树两个都是关的，所以要先开一个
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

CONFIG_OPPO_HEALTHINFO=y
CONFIG_OPPO_MEM_MONITOR=y
# 不开这个，oppo_project.h 会在头文件里生成函数体 -> vmlinux 链接多重定义
CONFIG_OPPO_COMMON_SOFT=y

# Android 的 paranoid network 会按 gid 拦 socket，容器里网络直接不通
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# 让 section mismatch 只告警不致命（OPPO 代码里 init/exit 标注本来就不干净）
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# 提供 get_PCB_Version / get_boot_mode 等实现（project_info/）
CONFIG_OPPO_DEVICE_IFNO=y

# 提供 VOOC / 充电 / crash reason 等实现，否则 gpioblib、schgm-flash 等引用会链接失败
CONFIG_OPPO_CHARGER=y
CONFIG_QPNP_SMB5=y
CONFIG_RECORD_MDMRST=y
CONFIG_RECORD_SLPIRST=y
